# First run only. Set your own strong password; never commit .env.
MAACC_ADMIN_PASSWORD=
MAACC_LISTEN=127.0.0.1:8421
MAACC_PUBLIC_URL=http://127.0.0.1:8421
MAACC_DB=data/control-center.db
MAACC_AGENT_ID=windows-agent
MAACC_AGENT_TOKEN=
MAACC_PRIMARY_NAME=主账号
MAACC_SECONDARY_NAME=副账号
# For non-loopback deployments, supply TLS or use an HTTPS reverse proxy.
MAACC_TLS_CERT=
MAACC_TLS_KEY=

# Optional public Skland binding API; requires the shared AstrBot Docker network.
# MAACC_SKLAND_UPSTREAM=http://astrbot:6190
